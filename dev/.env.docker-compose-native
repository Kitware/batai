DJANGO_SETTINGS_MODULE=bats_ai.settings.development
DJANGO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/django
DJANGO_CELERY_BROKER_URL=amqp://localhost:5672/
DJANGO_MINIO_STORAGE_URL=http://minioAccessKey:minioSecretKey@localhost:9000/django-storage

DJANGO_BATAI_WEB_URL=http://localhost:8080/
SERVERHOSTNAME=localhost

DJANGO_BATAI_NABAT_OIDC_CLIENT_ID=batai
DJANGO_BATAI_NABAT_OIDC_CLIENT_SECRET=batai-local-dev-secret
DJANGO_BATAI_NABAT_OIDC_ISSUER=http://localhost:8081/auth/realms/NABAT
DJANGO_BATAI_NABAT_OIDC_BASE_URL=http://localhost:8081/auth/realms/NABAT

# Only reachable if docker-compose-nabat-mock.yml's nabat-mock service is also up; otherwise
# inert, the same way the OIDC vars above are unused unless Keycloak is also up.
# In production environments, ensure that this environment variable is unset. The base settings
# module handles the real NABat graphql endpoint.
DJANGO_BATAI_NABAT_API_URL=http://localhost:8082/graphql

# Not read by Django/celery - this is picked up by `docker compose` itself (via shell env,
# since this file gets sourced with `set -a`) as the ${MINIO_ENDPOINT:-minio:9000}
# substitution in docker-compose-nabat-mock.yml. nabat-mock uses it to sign presigned
# URLs, and celery (running natively here, not in Docker) can't resolve the compose-network
# name "minio" - only this published port on localhost. Bring the mock stack up from a
# shell that's sourced this file (see dev/export-env.sh) so the override takes effect.
MINIO_ENDPOINT=localhost:9000

VITE_API_ROOT=http://localhost:8000
